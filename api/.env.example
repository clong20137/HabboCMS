# ========================
# SERVER
# ========================
PORT=3001
NODE_ENV=development

# Required in all environments
JWT_SECRET=replace_with_long_random_secret
AUTH_COOKIE_NAME=pluscms_token

# Comma-separated list of allowed origins.
# In production this MUST be set.
CORS_ORIGIN=http://localhost:5173

# Only enable in production behind HTTPS
USE_HOST_COOKIE_PREFIX=false

# If you are behind a proxy/load balancer, configure trust proxy.
# Examples: 1 (single proxy), 2, or "loopback".
TRUST_PROXY=1

# ========================
# DATABASE
# ========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace_me
DB_PASS=replace_me
DB_NAME=plus
DB_CONNECTION_LIMIT=10

# ========================
# NITRO CLIENT
# ========================
NITRO_URL=http://localhost:5173/nitro/

# ========================
# 2FA
# ========================
# 32+ chars. Prefer a random 64+ char secret.
TWOFA_ENC_KEY=replace_with_64_char_random_secret

# ========================
# CLOUDFLARE TURNSTILE
# ========================
# Leave blank to disable server-side Turnstile verification in development.
# Server secret only. Never expose this to the frontend.
TURNSTILE_SECRET=
