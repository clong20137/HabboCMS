{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },

  "include": ["src"],

  "exclude": [
    "node_modules",
    "build",
    "dist",
    "nitro",
    "nitro-assets",
    "swf",
    "public/nitro-assets",
    "src/app.ts",
    "src/index.ts",
    "src/auth.ts",
    "src/db.ts",
    "src/env.ts",
    "src/security.ts",
    "src/db",
    "src/errors",
    "src/housekeeping",
    "src/install",
    "src/middleware",
    "src/repositories",
    "src/routes",
    "src/services",
    "src/types/db",
    "src/utils",
    "src/validation"
  ]
}
